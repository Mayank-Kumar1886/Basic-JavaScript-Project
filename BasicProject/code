.mid .imageRight {
    margin: 20px;
    padding: 0 70px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .description {
    color: white;
    max-width: 40%;
  }
  
  .description h2 {
    font-size: 36px;
    margin-bottom: 10px;
  }
  
  .description p {
    font-size: 18px;
    line-height: 1.5;
  }
  
  .image-box {
    position: relative;
    width: 60%;
  }
  
  .image-box img {
    width: 100%;
    height: 55vh;
    border-radius: 50px;
  }
  
  .btn-group {
    position: absolute;
   
  }
  
  .btn-group button {
    width: 180px;
    padding: 10px 15px;
    background-color: #826bf5;
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    cursor: pointer;
    animation: blinkBackground 0.8s infinite;

  }
  .btn-group button:nth-child(0){
    animation-delay: 0s;
  }
  .btn-group button:nth-child(1){
    animation-delay: 0.5s;
  }
  .btn-group button:nth-child(2){
    animation-delay: 1s;
  }
  @keyframes blinkBackground {
    0%, 100% {
        background-color: #826bf5; /* Original color */
        box-shadow: 0 0 10px rgba(130, 107, 245, 0.7);

    }
    50% {
        background-color: #5a3dcf; /* Darker shade */
        box-shadow: 0 0 10px rgba(130, 107, 245, 0.7);

    }
}





